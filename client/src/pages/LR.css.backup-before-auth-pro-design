.lr-shell{max-width:1180px;margin:auto;padding:20px;font-family:Arial,sans-serif;background:linear-gradient(145deg,#f5f8ff,#fff);min-height:100vh;color:#18213a}.lr-hero{display:flex;align-items:center;gap:18px;background:#fff;border-radius:24px;padding:20px 26px;box-shadow:0 12px 35px #22325b20}.lr-logo{font-size:38px;font-weight:900;padding:14px 18px;border-radius:18px;background:linear-gradient(135deg,#e8f1ff,#fff1f1);direction:ltr}.lr-logo span{font-size:25px}.lr-hero h1{margin:0;font-size:29px}.lr-hero p{margin:5px 0}.lr-logout{margin-right:auto;border:0;border-radius:12px;padding:12px;background:#eef1f8;font-weight:700}.lr-progress-card,.lr-card{background:#fff;margin-top:18px;padding:22px;border-radius:22px;box-shadow:0 9px 28px #24355b17}.lr-progress-card{display:grid;gap:9px}.lr-progress{height:13px;background:#e7eaf1;border-radius:20px;overflow:hidden}.lr-progress i{display:block;height:100%;background:linear-gradient(90deg,#4f67db,#7b4de1);border-radius:20px}.lr-stage-strip{display:flex;gap:8px;overflow:auto;padding:15px 2px}.lr-stage-strip button{min-width:175px;border:0;padding:12px;border-radius:13px;background:#eef1f7;font-weight:700}.lr-stage-strip button.active{background:#493dc4;color:white}.lr-stage-strip button:disabled{opacity:.55}.lr-letter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:12px;margin:20px 0}.lr-letter{display:flex;flex-direction:column;align-items:center;gap:5px;border:1px solid #e3e6ef;border-radius:16px;padding:13px;background:#fbfcff}.lr-letter strong,.lr-big-letter{font-size:48px}.lr-letter span{font-size:18px}.lr-primary{display:block;margin:22px auto 0;border:0;border-radius:15px;padding:14px 26px;background:linear-gradient(135deg,#493dc4,#7353e6);color:#fff;font-size:18px;font-weight:800}.lr-primary:disabled{opacity:.45}.lr-big-letter,.lr-russian-name{text-align:center;font-weight:900;margin:28px;font-size:72px}.lr-russian-name{font-size:45px}.lr-options{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.lr-options button{border:2px solid #dce1ed;background:#fff;border-radius:15px;padding:16px;font-size:19px;font-weight:700}.lr-options button.selected{border-color:#5546d4;background:#efedff}.lr-options button.correct{background:#e3f8e8;border-color:#37a957}.lr-options button.wrong{background:#ffe7e7;border-color:#d24b4b}.lr-letter-options button{font-size:34px}.lr-question{padding:17px;margin:14px 0;border-radius:16px;background:#f7f8fc}.lr-success,.lr-retry{text-align:center;padding:20px;margin-top:18px;border-radius:18px}.lr-success{background:#e8f9ed}.lr-retry{background:#fff2df}.lr-phrase-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.lr-phrase-grid div{padding:16px;border-radius:15px;background:#f6f7fc;display:flex;flex-direction:column;gap:7px}@media(max-width:650px){.lr-shell{padding:10px}.lr-hero{flex-wrap:wrap}.lr-hero h1{font-size:22px}.lr-logout{margin-right:0}.lr-options{grid-template-columns:1fr}.lr-big-letter{font-size:64px}}